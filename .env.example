# Set these in your host's environment settings. server.js does not read this file.

# MySQL connection string. Until it is set, the waitlist form answers "temporarily unavailable".
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# On Railway you can skip this: the server also reads MYSQL_URL, which Railway's MySQL service provides.

# Port the server listens on.
PORT=3000

# Optional sign-up limits. The values shown are the defaults.
# WAITLIST_IP_LIMIT=20         sign-up attempts per visitor every 10 minutes
# WAITLIST_GLOBAL_LIMIT=1000   sign-up attempts per hour, all visitors combined
# TRUST_PROXY=1                set to 0 only if nothing sits in front of this server
