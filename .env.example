# Settings for the waitlist functions. On Vercel, set these under Project > Settings > Environment Variables.

# Postgres connection string. Adding a Neon database from Vercel's Storage tab sets this for you.
# Until it is set, the waitlist form answers "temporarily unavailable".
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: sign-up attempts allowed per visitor every 10 minutes (default 20).
# WAITLIST_IP_LIMIT=20

# ---- Rewrite service (POST /api/rewrite), used by the extension ----

# Anthropic API key. Set this on Vercel only; never commit a real key.
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
# REWRITE_MODEL=claude-haiku-5-5
# REWRITE_INSTALL_DAILY=40     free rewrites per installed copy per day
# REWRITE_NETWORK_DAILY=120    rewrites per network address per day
# REWRITE_WEB_DAILY=5          tries per browser per day in the website's try-it box
# REWRITE_WEB_NETWORK_DAILY=20  website tries per network address per day
# REWRITE_GLOBAL_DAILY=3000    rewrites per day for everyone combined (your spend ceiling)
