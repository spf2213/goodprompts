# Settings for the waitlist functions. On Vercel, set these under Project > Settings > Environment Variables.

# Postgres connection string. Adding a Neon database from Vercel's Storage tab sets this for you.
# Until it is set, the waitlist form answers "temporarily unavailable".
DATABASE_URL=postgres://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional: sign-up attempts allowed per visitor every 10 minutes (default 20).
# WAITLIST_IP_LIMIT=20
